# Public browser configuration only; use your own Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put Supabase secret/service-role keys in NEXT_PUBLIC_ variables.
# Configure private server secrets in Cloudflare environment settings, not Git.
# Optional official support channel shown on /contact/ (set only verified values).
HUSTLE_SUPPORT_EMAIL=
HUSTLE_SUPPORT_URL=
